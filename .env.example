NODE_ENV=development
PORT=4000
HOST=0.0.0.0

MONGO_URI=mongodb://127.0.0.1:27017/federix_central
REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

INTERNAL_SERVICE_TOKEN=change_me_shared_internal_token
FL_SERVER_ALLOWED_IPS=127.0.0.1,::1

SIGNED_URL_SECRET=change_me_signed_url_secret

SUPPORTED_SDK_VERSIONS=1.0.0,1.1.0
SERVER_TIMEZONE=Asia/Kolkata
MAX_UPDATE_SIZE_MB=256

BUILD_ID=dev-local

# --- Optional ---
LOG_LEVEL=info
# Serve HTTP/2 cleartext so native gRPC clients (grpcio, grpc-java, grpcurl -plaintext) work.
# Leave unset for HTTP/1.1 (Connect protocol: curl, browsers, @connectrpc/connect-web).
# HTTP2=true
# Production: HTTP/2 over TLS with HTTP/1.1 fallback.
# TLS_KEY=/path/to/key.pem
# TLS_CERT=/path/to/cert.pem
# Where signed /storage/... URLs read files from (local stand-in for S3/GCS).
STORAGE_DIR=./storage
