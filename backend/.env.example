NODE_ENV=development
PORT=4000
HOST=0.0.0.0

MONGO_URI=mongodb://127.0.0.1:27017/federix_central
REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

INTERNAL_SERVICE_TOKEN=change_me_shared_internal_token
FL_SERVER_ALLOWED_IPS=127.0.0.1,::1

SIGNED_URL_SECRET=change_me_signed_url_secret

SUPPORTED_SDK_VERSIONS=1.0.0,1.1.0
SERVER_TIMEZONE=Asia/Kolkata
MAX_UPDATE_SIZE_MB=256

BUILD_ID=dev-local

# --- Optional ---
LOG_LEVEL=info
# Serve HTTP/2 cleartext so native gRPC clients (grpcio, grpc-java, grpcurl -plaintext) work.
# Leave unset for HTTP/1.1 (Connect protocol: curl, browsers, @connectrpc/connect-web).
# HTTP2=true
# Production: HTTP/2 over TLS with HTTP/1.1 fallback.
# TLS_KEY=/path/to/key.pem
# TLS_CERT=/path/to/cert.pem
# Where signed /storage/... URLs read files from (local stand-in for S3/GCS).
STORAGE_DIR=./storage

HEARTBEAT_CHECK_INTERVAL_MS=30000
HEARTBEAT_TIMEOUT_MS=90000
EVENT_PING_INTERVAL_MS=30000
EVENT_QUEUE_MAX=1000
STREAM_AUTH_RECHECK_MS=30000
CLIENT_STATUS_CHECK_INTERVAL_MS=60000
CLIENT_IDLE_AFTER_MS=300000
CLIENT_DISCONNECTED_AFTER_MS=1800000
MAINTENANCE_TTL_SECONDS=86400
SIGNED_URL_TTL_SECONDS=600

BCRYPT_ROUNDS=10
MIN_SECRET_LENGTH=32
MIN_PASSWORD_LENGTH=8

DB_CONNECT_TIMEOUT_MS=3000
REDIS_BACKOFF_STEP_MS=200
REDIS_MAX_BACKOFF_MS=2000
REDIS_MAX_RETRIES_PER_REQUEST=3

MAX_LABEL_CLASSES=1000
MAX_LABEL_KEY_LENGTH=64
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=200
METRICS_ROUNDS_DEFAULT=20
METRICS_ROUNDS_MAX=200
CLIENT_METRICS_SCAN_FACTOR=50
CLIENT_HISTORY_LIMIT=50
CONFIG_HISTORY_LIMIT=100
LOGS_LIMIT_DEFAULT=100
LOGS_LIMIT_MAX=500
SELF_METRICS_LIMIT_DEFAULT=10
SELF_METRICS_LIMIT_MAX=100
UTILITY_AVG_WINDOW=200

METRICS_WINDOW_MS=60000
METRICS_MAX_SAMPLES=50000
AGGREGATION_BASE_MS=5000
AGGREGATION_PER_UPDATE_MS=800
