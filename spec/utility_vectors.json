      },
      "expected": {
        "quality": 0.999999995,
        "size": 1.0,
        "diversity": 1.0,
        "score": 0.9999999972222222
      },
      "tier": {
        "status": "accepted",
        "level": "none",
        "ratio": 1.0
      }
