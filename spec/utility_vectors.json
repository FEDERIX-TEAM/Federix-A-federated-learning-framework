      "input": {
        "local_loss_before": 2.0,
        "local_loss_after": 0.0,
        "data_size": 100000,
        "label_distribution": {
          "0": 100,
          "1": 100,
          "2": 100,
          "3": 100,
          "4": 100,
          "5": 100,
          "6": 100,
          "7": 100,
          "8": 100,
          "9": 100
